{
  "name": "crypto-futures-arb-scanner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "format": "prettier -w .",
    "typecheck:backend": "tsc -p tsconfig.json --noEmit",
    "typecheck:frontend": "tsc -p apps/web/tsconfig.json --noEmit",
    "typecheck": "npm run typecheck:backend && npm run typecheck:frontend",
    "typecheck:watch": "node scripts/typecheck-watch.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.2",
    "fastify-plugin": "^5.1.0",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.3",
    "ws": "^8.18.3",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@types/node": "^25.0.2",
    "@types/ws": "^8.18.1",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.7.4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}

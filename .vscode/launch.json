{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Backend: Dev Server",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "npm",
            "runtimeArgs": ["run", "dev"],
            "cwd": "${workspaceFolder}/backend",
            "console": "integratedTerminal",
            "skipFiles": ["<node_internals>/**"]
        },
        {
            "name": "Frontend: Dev Server",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "npm",
            "runtimeArgs": ["run", "dev"],
            "cwd": "${workspaceFolder}/frontend",
            "console": "integratedTerminal",
            "skipFiles": ["<node_internals>/**"]
        },
        {
            "name": "Backend: Debug Watch (tsx)",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "npm.cmd",
            "runtimeArgs": [
                "run",
                "debug:watch"
            ],
            "cwd": "${workspaceFolder}/backend",
            "console": "integratedTerminal",
            "sourceMaps": true,
            "smartStep": true,
            "restart": true,
            "autoAttachChildProcesses": true,
            "outputCapture": "std",
            "skipFiles": ["<node_internals>/**"]
        }
    ]
}
